<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 每天 06:30 运行一次每日任务。使用前把两处 /Users/you/Workspace/twitter-rss 换成你的项目路径，
  把 claude 换成你用的 Agent（claude / codex），然后：
    cp agents/com.xrss.daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.xrss.daily.plist
  电脑在 06:30 处于睡眠时，launchd 会在唤醒后补跑。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xrss.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/you/Workspace/twitter-rss/agents/agent-run.sh</string>
    <string>claude</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/you/Workspace/twitter-rss</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/xrss-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/xrss-daily.log</string>
</dict>
</plist>
