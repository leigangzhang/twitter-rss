{
  "title": "X 采集输出（每个账号一个文件）",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,15}$"
    },
    "status": {
      "default": "ok",
      "type": "string",
      "enum": [
        "ok",
        "rate_limited",
        "login_required",
        "captcha",
        "error"
      ]
    },
    "error": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "tweets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]{1,15}$"
              },
              "name": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "handle",
              "name"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "text": {
            "type": "string"
          },
          "textTruncated": {
            "default": false,
            "type": "boolean"
          },
          "lang": {
            "type": "string"
          },
          "isReply": {
            "default": false,
            "type": "boolean"
          },
          "isRepost": {
            "default": false,
            "type": "boolean"
          },
          "conversationId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "likes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reposts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "replies": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "quotes": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bookmarks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "views": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "likes",
              "reposts",
              "replies"
            ]
          },
          "media": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "photo",
                    "video",
                    "gif"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "durationSec": {
                  "type": "number",
                  "minimum": 0
                },
                "altText": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "url"
              ]
            }
          },
          "links": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "default": "web",
                  "type": "string",
                  "enum": [
                    "web",
                    "x_article"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "expandedUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "domain": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "imageUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url",
                "expandedUrl"
              ]
            }
          },
          "quoted": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "author": {
                "type": "object",
                "properties": {
                  "handle": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_]{1,15}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "avatarUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "handle",
                  "name"
                ]
              },
              "text": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "media": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "photo",
                        "video",
                        "gif"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "width": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "height": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "durationSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "altText": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "url"
                  ]
                }
              },
              "links": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "default": "web",
                      "type": "string",
                      "enum": [
                        "web",
                        "x_article"
                      ]
                    },
                    "url": {
                      "type": "string"
                    },
                    "expandedUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "imageUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "url",
                    "expandedUrl"
                  ]
                }
              }
            },
            "required": [
              "id",
              "url",
              "author",
              "text"
            ]
          },
          "thread": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                "text": {
                  "type": "string"
                },
                "media": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "photo",
                          "video",
                          "gif"
                        ]
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "width": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "height": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "durationSec": {
                        "type": "number",
                        "minimum": 0
                      },
                      "altText": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "url"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "url",
          "author",
          "createdAt",
          "text",
          "metrics"
        ]
      }
    }
  },
  "required": [
    "source",
    "collectedAt",
    "handle"
  ]
}
