# 数据库：本地开发用 SQLite 文件；上线后换成 Turso（libSQL）地址，网站和本地流水线共用
DATABASE_URL=file:../../data/app.db
DATABASE_AUTH_TOKEN=

# 配置目录（topics.yaml / digest.yaml），默认是仓库根目录下的 config/
# CONFIG_DIR=/absolute/path/to/config

# 大模型：AI 评审、翻译、媒体说明，以及采集 Agent（scripts/collect.sh）都用 DeepSeek
# 通过 DeepSeek 的 Anthropic 兼容接口调用：https://api-docs.deepseek.com/guides/anthropic_api
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com/anthropic

# 邮件发送：QQ 邮箱 SMTP（订阅确认邮件和每日精选邮件）
# SMTP_PASS 填"授权码"：QQ 邮箱网页版 → 设置 → 账号与安全 → 开启 POP3/IMAP/SMTP 服务后生成，不是 QQ 密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=yourname@qq.com
SMTP_PASS=
# 发件人显示名；地址必须与 SMTP_USER 一致
MAIL_FROM="精选晨报 <yourname@qq.com>"

# 网站公开地址，用于邮件里的确认、退订、RSS 链接
SITE_URL=http://localhost:3000
