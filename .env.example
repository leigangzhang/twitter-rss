# 数据库：本地开发用 SQLite 文件；上线后换成 Turso（libSQL）地址，网站和本地流水线共用
DATABASE_URL=file:../../data/app.db
DATABASE_AUTH_TOKEN=

# 配置目录（topics.yaml / digest.yaml），默认是仓库根目录下的 config/
# CONFIG_DIR=/absolute/path/to/config

# 大模型：AI 评审、翻译和文章摘要（采集用的 Agent 在 Agent 里单独配置）
# 支持两种接口格式，默认 DeepSeek 的 Anthropic 兼容接口：
# .env 里的 LLM_API_KEY 优先于系统环境变量
#   LLM_API       anthropic（Anthropic Messages API，默认）或 openai（OpenAI Chat Completions）
#   LLM_BASE_URL  端点地址，不用带 /v1/messages 或 /chat/completions
#   LLM_MODEL     模型名（需要支持工具调用；不需要图片输入）
#   LLM_API_KEY   该服务的 API Key（旧名 DEEPSEEK_API_KEY 仍然有效）
# 示例（以各家文档为准）：
#   anthropic  DeepSeek    https://api.deepseek.com/anthropic
#   anthropic  Anthropic   https://api.anthropic.com
#   anthropic  Kimi        https://api.moonshot.cn/anthropic
#   openai     OpenAI      https://api.openai.com/v1
#   openai     DeepSeek    https://api.deepseek.com/v1
#   openai     通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   openai     智谱 GLM     https://open.bigmodel.cn/api/paas/v4
#   openai     本地 Ollama  http://localhost:11434/v1
LLM_API=anthropic
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 邮件发送：QQ 邮箱 SMTP（订阅确认邮件和每日精选邮件）
# SMTP_PASS 填"授权码"：QQ 邮箱网页版 → 设置 → 账号与安全 → 开启 POP3/IMAP/SMTP 服务后生成，不是 QQ 密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=yourname@qq.com
SMTP_PASS=
# 发件人显示名；地址必须与 SMTP_USER 一致
MAIL_FROM="精选晨报 <yourname@qq.com>"

# 网站公开地址，用于邮件里的确认、退订、RSS 链接
SITE_URL=http://localhost:3000

# 订阅者管理页 /admin/subscribers 的登录密码；不设置时这个页面不开放
ADMIN_PASSWORD=

# 每日任务有异常（采集停止、没有采集、账号不存在、发送失败）时，把提醒发到这个邮箱；不设置时不发
ADMIN_EMAIL=

# 脚本采集（pnpm crawl:auto / scripts/daily-auto.sh）
# WireGuard 隧道名（WireGuard App 左侧列表里的名字）；连不上 X 时用它自动连接。不设置时自动用第一个 WireGuard 隧道
WG_TUNNEL=
# 采集专用 Chrome（独立资料，只登录小号），一般不用改
# XRSS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# XRSS_CHROME_PROFILE=/Users/you/.xrss-chrome
# XRSS_CHROME_PORT=9333
# 到几点仍连不上 X 就放弃今天的采集（默认 10）
# XRSS_DEADLINE_HOUR=10
